#!/usr/bin/env python3
import json, os, subprocess, gi
from pathlib import Path
gi.require_version('Gtk','3.0'); gi.require_version('Gdk','3.0')
from gi.repository import Gtk, Gdk, GLib

CFG=Path.home()/'.config/verbyos/dock.json'
DEFAULT=[('Files','thunar'),('Firefox','firefox'),('Terminal','xfce4-terminal'),('Settings','verby-settings'),('Steam','steam'),('Discord','verby-discord'),('Geometry Dash','verby-geometry-dash'),('Minecraft','verby-minecraft'),('VLC','vlc')]

def installed(cmd): return subprocess.call(['sh','-c',f'command -v {cmd} >/dev/null 2>&1'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)==0
class Dock(Gtk.Window):
 def __init__(self):
  super().__init__(type=Gtk.WindowType.POPUP); self.set_decorated(False); self.set_keep_above(True); self.set_skip_taskbar_hint(True); self.set_skip_pager_hint(True)
  self.stick(); self.set_app_paintable(True)
  css=Gtk.CssProvider(); css.load_from_data(b'.dock{background:rgba(30,30,36,0.86);border-radius:20px;padding:7px}.dock button{background:transparent;border:0;padding:5px}.dock button:hover{background:rgba(255,255,255,0.10);border-radius:14px}')
  Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(),css,Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
  self.box=Gtk.Box(spacing=2); self.box.get_style_context().add_class('dock'); self.add(self.box); self.load()
  self.connect('realize',lambda *_: self.position()); self.connect('destroy',Gtk.main_quit)
 def load(self):
  try: items=json.loads(CFG.read_text())
  except Exception: items=DEFAULT
  for name,cmd in items:
   if not installed(cmd): continue
   b=Gtk.Button(); b.set_tooltip_text(name); b.set_relief(Gtk.ReliefStyle.NONE)
   img=Gtk.Image.new_from_icon_name({'Files':'system-file-manager','Firefox':'firefox','Terminal':'utilities-terminal','Settings':'preferences-system','Steam':'steam','VLC':'multimedia-player','Discord':'discord'}.get(name,'application-x-executable'),Gtk.IconSize.DIALOG)
   b.add(img); b.connect('enter-notify-event',self.enlarge,img); b.connect('leave-notify-event',self.shrink,img); b.connect('clicked',lambda _,c=cmd:self.launch(c)); self.box.pack_start(b,False,False,0)
  self.show_all()
 def enlarge(self,*a): a[1].set_pixel_size(54)
 def shrink(self,*a): a[1].set_pixel_size(42)
 def launch(self,c): subprocess.Popen([c],start_new_session=True)
 def position(self):
  d=Gdk.Display.get_default(); m=d.get_primary_monitor(); r=m.get_geometry(); w=self.get_allocated_width(); h=self.get_allocated_height(); self.move(r.x+(r.width-w)//2,r.y+r.height-h-18)
Gtk.init([]); Dock(); Gtk.main()
